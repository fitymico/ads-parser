# =============================================================================
# Конфигурация ads-parser
# Скопируйте в config.env и настройте под себя
# =============================================================================

# Директории
INSTALL_DIR=/opt/ads-parser
DATA_DIR=/data

# Парсер
WORKERS=6
DELAY=0.1

# Пользователь (для systemd)
PARSER_USER=parser

# Telegram алерты (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Git репозиторий (если используется)
REPO_URL=https://github.com/your-repo/ads-parser.git

# Healthcheck пороги
MAX_LOG_AGE_MINUTES=10
MAX_NO_PROGRESS_MINUTES=30
MIN_DISK_SPACE_GB=5
